# PostgreSQL — usá Neon (gratis en neon.tech) o Vercel Postgres
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# URL de la aplicación (cambiar por el dominio de Vercel en producción)
NEXTAUTH_URL="https://tu-proyecto.vercel.app"

# Secreto para NextAuth — generá uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro"

# Google Places API (para búsqueda de lugares)
# GOOGLE_PLACES_API_KEY=your_google_places_api_key
